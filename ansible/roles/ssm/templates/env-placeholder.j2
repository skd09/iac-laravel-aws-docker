# =============================================================================
# {{ item.item.1.id | upper }} - {{ env | upper }} Environment
# =============================================================================
# PLACEHOLDER - Create SSM Parameter:
# /{{ project_name }}/{{ env }}/{{ item.item.1.id }}/.env
# =============================================================================

APP_NAME={{ item.item.1.id | title | replace('-', '') }}
APP_ENV={{ env }}
APP_KEY=base64:CHANGE_ME_RUN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG={{ 'true' if env == 'dev' else 'false' }}
APP_URL=https://{{ item.item.1.subdomain }}-{{ env }}.{{ base_domain }}

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST={{ db_host | default('localhost') }}
DB_PORT={{ db_port | default('3306') }}
DB_DATABASE={{ item.item.1.db_name }}_{{ env }}
DB_USERNAME={{ db_username | default('root') }}
DB_PASSWORD={{ db_password | default('') }}

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION={{ aws_region }}
AWS_BUCKET={{ s3_bucket_prefix }}-{{ item.item.1.id }}-uploads