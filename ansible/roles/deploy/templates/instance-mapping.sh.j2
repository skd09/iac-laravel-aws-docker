#!/bin/bash
# =============================================================================
# Instance Mapping - Generated by Ansible
# DO NOT EDIT MANUALLY
# =============================================================================
# URL Pattern: {subdomain}-{env}.{{ base_domain }}
# SSM Pattern: /{{ project_name }}/{env}/{instance_id}/.env
# =============================================================================

get_instance_config() {
    local INSTANCE_ID="$1"
    local ENV="$2"

    case "$INSTANCE_ID" in
{% for app in apps %}
{% for instance in app.instances %}
        {{ instance.id }})
            APP_NAME="{{ app.name }}"
            if [ "$ENV" = "dev" ]; then
                BRANCH="{{ instance.branches.dev }}"
            else
                BRANCH="{{ instance.branches.stag }}"
            fi
            APP_DIR="{{ apps_base_dir }}/{{ app.name }}/${BRANCH}"
            SSM_PATH="/{{ project_name }}/${ENV}/{{ instance.id }}/.env"
            APP_URL="{{ instance.subdomain }}-${ENV}.{{ base_domain }}"
            ;;
{% endfor %}
{% endfor %}
        *)
            APP_NAME=""
            BRANCH=""
            APP_DIR=""
            SSM_PATH=""
            APP_URL=""
            ;;
    esac

    export APP_NAME BRANCH APP_DIR SSM_PATH APP_URL
}

export -f get_instance_config